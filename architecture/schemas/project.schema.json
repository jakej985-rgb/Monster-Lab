{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectSchema",
  "type": "object",
  "required": ["id", "title", "tagline", "tier", "estimatedMinutes", "requiredComponents", "prerequisiteLessons", "phases", "xpReward"],
  "properties": {
    "id": { "type": "string", "pattern": "^proj_[0-9]{2}$" },
    "title": { "type": "string", "minLength": 3 },
    "tagline": { "type": "string" },
    "story": { "type": "string" },
    "tier": { "type": "string", "enum": ["rookie", "builder", "engineer", "monsterMaster"] },
    "estimatedMinutes": { "type": "integer", "minimum": 15, "maximum": 180 },
    "requiredComponents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prerequisiteLessons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "phases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["phaseNumber", "phaseTitle", "type", "instructions"],
        "properties": {
          "phaseNumber": { "type": "integer", "minimum": 1 },
          "phaseTitle": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["gatherParts", "breadboardWiring", "wiringCheck", "codeReview", "uploadSketch", "physicalTest", "debugTuning", "missionComplete"]
          },
          "instructions": { "type": "string" },
          "diagramAsset": { "type": "string" },
          "inoSketchPath": { "type": "string" },
          "codeSnippet": { "type": "string" },
          "codeExplanation": { "type": "string" },
          "wiringConnections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "wire", "type"],
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "wire": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          },
          "verificationCheckpoints": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "troubleshooting": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symptom", "cause", "solution"],
        "properties": {
          "symptom": { "type": "string" },
          "cause": { "type": "string" },
          "solution": { "type": "string" },
          "category": { "type": "string", "enum": ["power", "wiring", "code", "upload", "logic"] },
          "diagnosticSteps": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },

    "xpReward": { "type": "integer", "minimum": 50 },
    "badgeRewardId": { "type": "string" }
  }
}
